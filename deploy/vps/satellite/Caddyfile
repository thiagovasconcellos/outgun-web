# Borda HTTPS do servidor satélite (OG-548): certificado automático para DOMAIN (Let's Encrypt).
# Só o game server sai: WebSocket das salas, replays, mapas e /health (ping do lobby); o resto vai
# para o site principal.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	handle_path /gs/* {
		@metrics path /metrics
		respond @metrics 404
		reverse_proxy game-server:7700
	}
	handle {
		redir {$SITE_ORIGIN} temporary
	}
}
