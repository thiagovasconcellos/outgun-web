{
  "name": "@outgun/api",
  "version": "2.67.0",
  "private": true,
  "description": "API da plataforma: contas, ranking, salas (card OG-080).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "map-imports"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js",
    "migrate": "node dist/cli.js migrate",
    "seed": "node dist/cli.js seed",
    "openapi": "node dist/cli.js openapi openapi.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@fastify/type-provider-typebox": "6.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "@node-rs/argon2": "2.2.2",
    "@outgun/content": "workspace:*",
    "@outgun/observability": "workspace:*",
    "@outgun/protocol": "workspace:*",
    "@outgun/settings": "workspace:*",
    "@outgun/tickets": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "openskill": "5.0.1",
    "postgres": "3.4.9",
    "typebox": "1.4.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
